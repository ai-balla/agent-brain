# ---------------------------------------------------------------------------
# Agent Brain - configuration template
# Copy me to .env  (setup.sh does this for you), then fill in the values.
#   cp .env.example .env && $EDITOR .env
# NEVER commit .env — it is git-ignored.
# ---------------------------------------------------------------------------

# --- Basics -----------------------------------------------------------------
DOMAIN_NAME=        # public hostname of your hub, e.g. hub.example.com
                    # (git-over-ssh reuses this hostname on the SSH port)
OWNER_EMAIL=        # you / license email

# --- Identity (used for git commits inside the vault) -----------------------
GIT_USER_NAME=      # e.g. ai-agent
GIT_USER_EMAIL=

# --- Host user ids: must match the uid/gid that owns ./data on this machine --
PUID=1000
PGID=1000

# --- Versions / ports -------------------------------------------------------
GITEA_VERSION=1.27
GITEA_PORT=3004
GITEA_SSH_PORT=2222
MCP_PORT=8083

# --- Gitea admin (setup.sh generates GITEA_ADMIN_PASSWORD if left empty) ----
GITEA_ADMIN_USERNAME=ai-agent
GITEA_ADMIN_PASSWORD=

# --- Cloudflare Access (for remote agents over the tunnel) ------------------
# Service token: Cloudflare Zero Trust -> Access -> Service Auth -> create one.
# Required for remote/authenticated use. Leave empty for local-only.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Only allow this if you run the bridge on localhost WITHOUT a tunnel and
# accept no authentication. Not needed when CF credentials above are set.
MCP_ALLOW_NO_AUTH=false

# --- Per-agent scoping (recommended for any remote setup) -------------------
# Map each Cloudflare service-token CLIENT_ID to a workspace subpath of the
# vault plus optional read-only. Agents can only reach their own workspace.
#   AGENT_SCOPES='{"<clientId>":{"roots":["agents/opencode"],"readonly":false,"name":"opencode"}, "<clientId2>":{"roots":["projects/foo"],"readonly":true,"name":"foo-reader"}}'
# ENFORCE_SCOPES=true denies clients NOT listed here (strict mode).
# WRITE_APPROVAL=true stages write_file under vault/_pending/<agent>/... so a
# human approves by moving the file to its final place (Obsidian/git).
AGENT_SCOPES=
ENFORCE_SCOPES=false
WRITE_APPROVAL=false
# Where mcp-bridge appends its append-only audit log (mounted to ./data/audit).
AUDIT_LOG_PATH=/audit/access.jsonl

# --- Optional: GitHub mirror automation -------------------------------------
# Classic PAT with repo read scope (see install summary). If empty, mirroring
# is skipped by brain-hub.
GH_TOKEN=

# --- Optional: remote tunnel -----------------------------------------------
# cloudflared remote tunnel token. Empty = tunnel service not started.
# Launch with:  docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# --- Housekeeping -----------------------------------------------------------
BACKUP_RETENTION_DAYS=14